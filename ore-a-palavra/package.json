{
  "name": "ore-a-palavra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "App que ajuda a orar e declarar a Bíblia: encontra versículos para a sua situação e monta uma oração com eles.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:html": "tsc -b && vite build --config vite.config.single.ts",
    "preview": "vite preview",
    "server": "node server/server.mjs",
    "start": "npm run build && node server/server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
